# App Configuration
APP_NAME="Polyfollow - Polymarket Bandar Tracker"
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=INFO

# Database Connection
# Default SQLite (for direct execution / standalone):
DATABASE_URL=sqlite+aiosqlite:///./polyfollow.db

# PostgreSQL (uncomment if using Docker Compose or VPS PostgreSQL):
# DATABASE_URL=postgresql+asyncpg://polyfollow:polyfollow_secret_pwd@postgres:5432/polyfollow_db

# Worker & Discovery
POLLING_INTERVAL_SECONDS=30
ENABLE_BACKGROUND_POLLER=true
ENABLE_AUTO_DISCOVERY=true
AUTO_DISCOVERY_INTERVAL_RUNS=10
REQUEST_TIMEOUT_SECONDS=15.0
MAX_RETRIES=3

# Polymarket API Endpoints
POLYMARKET_DATA_API_BASE=https://data-api.polymarket.com
POLYMARKET_GAMMA_API_BASE=https://gamma-api.polymarket.com
